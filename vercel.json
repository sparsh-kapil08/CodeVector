{
  "version": 2,
  "installCommand": "npm install && cd Frontend/Frontend && npm install",
  "buildCommand": "cd Frontend/Frontend && npm run build",
  "outputDirectory": "Frontend/Frontend/dist",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/Frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "Frontend/Frontend/dist/index.html"
    }
  ]
}
